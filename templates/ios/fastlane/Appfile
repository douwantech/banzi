# 班子 · iOS Appfile（模板）。按项目填，或用环境变量覆盖。
app_identifier(ENV["APP_IDENTIFIER"])      # 例如 com.example.app
apple_id(ENV["APPLE_ID"])                  # 可选：Apple 账号（用 ASC API Key 时通常不需要）
itc_team_id(ENV["ASC_TEAM_ID"])            # App Store Connect team id（可选）
team_id(ENV["DEV_TEAM_ID"])                # Developer Portal team id
